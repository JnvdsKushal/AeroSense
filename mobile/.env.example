# Copy this file to .env and fill in the values for your environment.
# Expo inlines any EXPO_PUBLIC_* variable into the JS bundle at build/start
# time — restart `expo start` after changing this file.

# Base URL of the Aero-Sense Rust/Axum backend's API, INCLUDING the /api
# suffix. The backend's own routes live under /api/* (see
# backend/src/routes/mod.rs) with an unauthenticated /health check at the
# root — this app derives that health URL from this value automatically.
#
# - iOS Simulator / Android Emulator on the same machine as the backend:
#     EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
#
# - Physical phone on the same Wi-Fi/LAN as your dev machine — "localhost"
#   on a physical device means the phone itself, NOT your computer, so you
#   must use your machine's LAN IP (find it with `ipconfig` on Windows or
#   `ifconfig`/`ip a` on macOS/Linux):
#     EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:8080/api
#
# - Staging / production:
#     EXPO_PUBLIC_API_BASE_URL=https://api.staging.aerosense.example/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
